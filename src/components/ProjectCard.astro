---
const { number, category, title, description, href, theme, mark, label } = Astro.props;
---
<article class="project-card">
  <a href={href} aria-label={`Conheça o projeto ${title}`}>
    <div class={`project-visual project-visual--${theme}`} aria-hidden="true">
      <span class="project-symbol">{mark}</span>
      <div class="project-visual-label"><span>{label}</span><span>{number}</span></div>
    </div>
  </a>
  <div class="project-content">
    <div class="project-meta"><span>{category}</span><span>{number}</span></div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="text-link" href={href}>Ver projeto <span class="arrow">↗</span></a>
  </div>
</article>
