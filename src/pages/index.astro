
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cristiano Alice — Produto, Projetos e Inovação"
  description="Profissional com 13 anos de experiência no Laboratório Bridge/UFSC. Gestão de produtos e projetos digitais, estratégia, design e inovação."
>
  <!-- Apresentação principal -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow hero-kicker">Cristiano Alice · Portfólio profissional</p>

        <h1 class="hero-title">
          Produto, projetos e <em>inovação.</em>
        </h1>

        <p class="hero-description">
          Conecto design, tecnologia e pessoas para transformar desafios<br>
          em soluções e experiências de valor.
        </p>

        <div class="hero-actions">
          <a class="button" href="/projetos">
            Explorar projetos <span class="arrow">↗</span>
          </a>

          <a class="text-link" href="/sobre">
            Conheça minha trajetória <span class="arrow">→</span>
          </a>
        </div>

        <p class="hero-note">
          13 anos de experiência · Design · Tecnologia · Gestão
        </p>
      </div>

      <div class="hero-art">
        <div class="hero-art-grid"></div>
        <span class="hero-index">01 / IDENTIDADE</span>
        <div class="hero-monogram">C<span>A</span>.</div>
        <div class="hero-art-label">
          <span>Produto</span>
          <span>Projetos</span>
          <span>Inovação</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Destaques profissionais -->
  <section class="ticker">
    <div class="container ticker-inner">
      <span>Gestão de Projetos</span>
      <span class="ticker-dot"></span>
      <span>Inovação</span>
      <span class="ticker-dot"></span>
      <span>Metodologias Ágeis</span>
      <span class="ticker-dot"></span>
      <span>Melhoria Contínua</span>
    </div>
  </section>

  <!-- Apresentação da trajetória -->
  <section class="section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">01 · Minha trajetória</p>
        <h2 class="section-title">
          Experiência que conecta <em>diferentes perspectivas.</em>
        </h2>
      </div>

      <div>
        <div class="intro-copy">
          <p>
            Ao longo de <strong>13 anos no Laboratório Bridge,
            vinculado à UFSC</strong>, construí uma trajetória
            profissional que integra educação, tecnologia, qualidade,
            gestão e inovação.
          </p>

          <p>
            Atuei na gestão de cursos e equipes, no planejamento de
            iniciativas educacionais digitais, em ambientes virtuais
            de aprendizagem e em atividades de qualidade de software
            e melhoria de processos.
          </p>

          <p>
            Minha formação em Design de Produto e meu mestrado em
            Engenharia de Produção e Sistemas complementam essa
            experiência, reunindo criatividade, pensamento analítico
            e visão sistêmica.
          </p>
        </div>

        <a class="text-link" href="/sobre">
          Conheça minha história completa <span class="arrow">→</span>
        </a>
      </div>
    </div>

    <!-- Pilares profissionais -->
    <div class="container principles">
      <article class="principle">
        <span class="principle-number">01</span>
        <h3>Produto</h3>
        <p>Visão centrada nas pessoas, compreensão de necessidades
          e desenvolvimento de soluções relevantes.</p>
      </article>

      <article class="principle">
        <span class="principle-number">02</span>
        <h3>Projetos</h3>
        <p>Planejamento, organização, colaboração e capacidade
          de transformar objetivos em entregas.</p>
      </article>

      <article class="principle">
        <span class="principle-number">03</span>
        <h3>Inovação</h3>
        <p>Conexão entre criatividade, tecnologia e processos
          para explorar novas possibilidades.</p>
      </article>
    </div>
  </section>

  <!-- Projetos -->
  <section class="section projects-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 · Experiência em prática</p>
          <h2 class="section-title">
            Ideias que se transformam em <em>projetos.</em>
          </h2>
        </div>

        <a class="text-link" href="/projetos">
          Ver todos os projetos <span class="arrow">→</span>
        </a>
      </div>

      <div class="project-grid">
        <article class="project-card">
          <div class="project-visual project-visual--education">
            <span class="project-symbol">Ed.</span>
            <div class="project-visual-label">
              <span>01</span>
              <span>Educação digital</span>
            </div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span>Educação</span>
              <span>01</span>
            </div>
            <h3>Educação Digital</h3>
            <p>
              Gestão de cursos, experiências de aprendizagem e
              iniciativas de formação em ambientes digitais.
            </p>
            <a class="text-link" href="/projetos/educacao-digital">
              Conhecer projeto <span class="arrow">→</span>
            </a>
          </div>
        </article>

        <article class="project-card">
          <div class="project-visual project-visual--quality">
            <span class="project-symbol">QA.</span>
            <div class="project-visual-label">
              <span>02</span>
              <span>Qualidade e processos</span>
            </div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span>Tecnologia</span>
              <span>02</span>
            </div>
            <h3>Qualidade e Processos</h3>
            <p>
              Qualidade de software, testes de fluxos de trabalho
              e melhoria da experiência do usuário.
            </p>
            <a class="text-link" href="/projetos/qualidade-processos">
              Conhecer projeto <span class="arrow">→</span>
            </a>
          </div>
        </article>

        <article class="project-card">
          <div class="project-visual project-visual--creative">
            <span class="project-symbol">EC.</span>
            <div class="project-visual-label">
              <span>03</span>
              <span>Design e tecnologia</span>
            </div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span>Projeto autoral</span>
              <span>03</span>
            </div>
            <h3>Energia Criativa</h3>
            <p>
              Um conceito que integra design, tecnologia e cultura
              do surf em experiências criativas.
            </p>
            <a class="text-link" href="/projetos/energia-criativa">
              Conhecer projeto <span class="arrow">→</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Competências -->
  <section class="section">
    <div class="container expertise-grid">
      <div>
        <p class="eyebrow">03 · Atuação</p>
        <h2 class="section-title section-title-spaced">
          Estratégia com capacidade de <em>execução.</em>
        </h2>
        <p class="section-intro">
          Uma visão multidisciplinar para conectar pessoas,
          tecnologia e objetivos.
        </p>
      </div>

      <div class="expertise-list">
        <article class="expertise-item">
          <span>01</span>
          <div>
            <h3>Gestão de produtos e projetos digitais</h3>
            <p>Organização de iniciativas, visão de produto e
              condução de projetos multidisciplinares.</p>
          </div>
        </article>

        <article class="expertise-item">
          <span>02</span>
          <div>
            <h3>Educação e tecnologia</h3>
            <p>Planejamento educacional, ambientes virtuais
              e experiências digitais de aprendizagem.</p>
          </div>
        </article>

        <article class="expertise-item">
          <span>03</span>
          <div>
            <h3>Qualidade e processos</h3>
            <p>QA, análise de fluxos de trabalho,
              experiência do usuário e melhoria contínua.</p>
          </div>
        </article>

        <article class="expertise-item">
          <span>04</span>
          <div>
            <h3>Estratégia e inovação</h3>
            <p>Integração entre criatividade, visão sistêmica
              e desenvolvimento de novas soluções.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Encerramento -->
  <section class="contact-band">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">04 · Novas possibilidades</p>
        <h2 class="section-title">
          Vamos transformar boas ideias em <em>realidade?</em>
        </h2>
        <p class="contact-copy">
          Estou aberto a novas oportunidades, projetos e conexões
          que aproximem produto, tecnologia e inovação.
        </p>
      </div>

      <a class="button button-light" href="/sobre">
        Vamos conversar <span class="arrow">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
