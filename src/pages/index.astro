---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
const projects = [
  {number:"01",category:"Educação digital",title:"Formação e experiências de aprendizagem",description:"Planejamento e gestão de iniciativas educacionais digitais, conectando conteúdo, tecnologia, equipes e experiência de aprendizagem.",href:"/projetos/educacao-digital/",theme:"education",mark:"E+",label:"Learning"},
  {number:"02",category:"Qualidade & produto",title:"Qualidade de software e processos",description:"Validação de fluxos de trabalho e jornadas do usuário, com foco em qualidade, usabilidade e melhoria contínua.",href:"/projetos/qualidade-processos/",theme:"quality",mark:"Q.",label:"Quality"},
  {number:"03",category:"Projeto autoral",title:"Energia Criativa",description:"Uma exploração autoral entre design, cultura do surf e tecnologia para criar experiências de comunicação visual.",href:"/projetos/energia-criativa/",theme:"creative",mark:"EC",label:"Design + Tech"}
];
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow hero-kicker">Portfólio profissional · 2026</p>
        <h1 class="hero-title">Ideias ganham força quando <em>design, tecnologia</em> e propósito se encontram.</h1>
        <p class="hero-description">Sou Cristiano Alice. Minha trajetória conecta design de produto, educação digital, qualidade de software e gestão de projetos para transformar necessidades em experiências relevantes.</p>
        <div class="hero-actions">
          <a class="button" href="/projetos/">Explorar projetos <span class="arrow">↗</span></a>
          <a class="text-link" href="/sobre/">Conhecer minha trajetória <span class="arrow">→</span></a>
        </div>
        <p class="hero-note">Design de produto · Educação digital · Tecnologia · Inovação</p>
      </div>
      <div class="hero-art" aria-label="Monograma CA em composição gráfica editorial">
        <div class="hero-art-grid"></div><span class="hero-index">CA / 001</span>
        <div class="hero-monogram">C<span>A</span>.</div>
        <div class="hero-art-label"><span>Designing what matters</span><span>Florianópolis · Brasil</span></div>
      </div>
    </div>
  </section>
  <div class="ticker"><div class="container ticker-inner">
    <span>Design estratégico</span><i class="ticker-dot"></i><span>Educação digital</span><i class="ticker-dot"></i><span>Qualidade & UX</span><i class="ticker-dot"></i><span>Gestão & inovação</span>
  </div></div>
  <section class="section" id="sobre">
    <div class="container">
      <div class="intro-grid">
        <div><p class="eyebrow">01 · Visão profissional</p><h2 class="section-title">Conectar pontos. <em>Criar valor.</em></h2></div>
        <div>
          <p class="intro-copy">Minha experiência está na interseção entre <strong>pessoas, processos e tecnologia</strong>. Ao longo da trajetória, participei da gestão de iniciativas de educação digital, da organização de equipes e da validação de experiências em produtos e plataformas.</p>
          <p class="intro-copy">A formação em Design de Produto e o mestrado em Engenharia de Produção e Sistemas ampliam esse olhar: pensar de forma criativa, estruturar soluções e transformar ideias em entregas consistentes.</p>
          <a class="text-link" href="/sobre/">Mais sobre minha trajetória <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="principles">
        <article class="principle"><span class="principle-number">01</span><h3>Visão sistêmica</h3><p>Entender necessidades, contextos e relações entre as partes.</p></article>
        <article class="principle"><span class="principle-number">02</span><h3>Colaboração</h3><p>Mobilizar conhecimentos e pessoas em torno de objetivos comuns.</p></article>
        <article class="principle"><span class="principle-number">03</span><h3>Melhoria contínua</h3><p>Aprender com o uso, qualificar processos e evoluir soluções.</p></article>
      </div>
    </div>
  </section>
  <section class="section projects-section" id="projetos">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">02 · Trabalhos selecionados</p><h2 class="section-title">Projetos que traduzem <em>experiência em prática.</em></h2></div><a class="text-link" href="/projetos/">Ver todos os projetos <span class="arrow">↗</span></a></div>
      <div class="project-grid">{projects.map((project) => <ProjectCard {...project} />)}</div>
    </div>
  </section>
  <section class="section" id="atuacao">
    <div class="container expertise-grid">
      <div><p class="eyebrow">03 · Áreas de atuação</p><h2 class="section-title">Um repertório que combina <em>estratégia e execução.</em></h2><p class="section-intro">Competências construídas na prática, em projetos que envolvem tecnologia, aprendizagem e experiência do usuário.</p></div>
      <div class="expertise-list">
        <article class="expertise-item"><span>01</span><div><h3>Gestão de projetos e produtos digitais</h3><p>Planejamento, organização de entregas, acompanhamento e colaboração entre equipes.</p></div></article>
        <article class="expertise-item"><span>02</span><div><h3>Educação e ambientes digitais</h3><p>Gestão de cursos, experiências de aprendizagem e plataformas como Moodle.</p></div></article>
        <article class="expertise-item"><span>03</span><div><h3>Qualidade, processos e UX</h3><p>Testes, validação de fluxos, análise de jornadas e melhoria da experiência.</p></div></article>
        <article class="expertise-item"><span>04</span><div><h3>Design, criatividade e inovação</h3><p>Visão de design aplicada à concepção de soluções e novas possibilidades.</p></div></article>
      </div>
    </div>
  </section>
  <section class="contact-band" id="contato">
    <div class="container contact-grid">
      <div><p class="eyebrow">04 · Próximas conexões</p><h2 class="section-title">Boas ideias começam com uma <em>boa conversa.</em></h2></div>
      <div><p class="contact-copy">Este portfólio está em construção. Em breve, esta área reunirá os canais diretos para conversas sobre oportunidades, projetos e colaboração.</p><a class="button button-light" href="https://github.com/cristiano-francoalice" target="_blank" rel="noreferrer">Acompanhar no GitHub <span class="arrow">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
